# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# Virtual environments
.venv/
venv/
env/

# Transfer artifacts (partial files, resume state, generated manifests)
*.part
*.lossless-state.json
*.tmp
*.lossless-manifest.json
.lossless-web/

# Local verification output / received files
received/
verify_output/
*.log

# The shared folder is live data (photos/videos), not source
shared/

# Self-signed TLS certificates (contain a PRIVATE KEY - never commit these)
*.pem
*.key
*.pfx
*.p12
tls/
demo_tls/
demo_web/
demo_tunnel/
# ...except the deliberately-public throwaway key used only by unit tests
!tests/fixtures/test_cert.pem
!tests/fixtures/test_key.pem

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
