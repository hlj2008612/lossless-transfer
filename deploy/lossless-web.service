[Unit]
Description=lossless-transfer web (photo/video transfer, byte-exact)
Documentation=https://github.com/hlj2008612/lossless-transfer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mq
Group=mq
WorkingDirectory=/home/mq/lossless-transfer
# Keeps the launcher's behaviour: generate tls/ if missing, pick the
# interpreter, then exec web_transfer.py in the foreground (systemd is the
# supervisor here, so no extra backgrounding).
Environment=PYTHON_EXE=/usr/bin/python3
# OPEN MODE: no token. Anyone who can reach the tunnel can upload, download and
# delete. 127.0.0.1 below is what keeps the LAN out - the tunnel is the only
# entry. To require a token again, drop --open and add either
#   EnvironmentFile=-/etc/lossless-web.env   (with LT_TOKEN=...)
# or  --token 'long-random-string'  to the ExecStart line.
# 127.0.0.1 is deliberate. A tunnel (frpc on this box) or a reverse proxy is the
# only intended entry point; 0.0.0.0 would hand upload/download/DELETE to the
# whole LAN as well.
ExecStart=/home/mq/lossless-transfer/scripts/start_web.sh --behind-tls --open --dir shared --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
# A transfer is a long-lived socket; do not let a slow LAN packet kill it.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
